{
  "applyKeypadKey": [
    {
      "name": "comma: empty + digit",
      "input": {
        "buffer": "",
        "key": "5",
        "decimalSeparator": ","
      },
      "expected": "5"
    },
    {
      "name": "comma: 0 + 0",
      "input": {
        "buffer": "0",
        "key": "0",
        "decimalSeparator": ","
      },
      "expected": "0"
    },
    {
      "name": "comma: 0 + 7",
      "input": {
        "buffer": "0",
        "key": "7",
        "decimalSeparator": ","
      },
      "expected": "7"
    },
    {
      "name": "comma: 12 + comma",
      "input": {
        "buffer": "12",
        "key": ",",
        "decimalSeparator": ","
      },
      "expected": "12,"
    },
    {
      "name": "comma: 12, + comma (already has separator)",
      "input": {
        "buffer": "12,",
        "key": ",",
        "decimalSeparator": ","
      },
      "expected": "12,"
    },
    {
      "name": "comma: empty + comma",
      "input": {
        "buffer": "",
        "key": ",",
        "decimalSeparator": ","
      },
      "expected": "0,"
    },
    {
      "name": "comma: 12,5 + 0",
      "input": {
        "buffer": "12,5",
        "key": "0",
        "decimalSeparator": ","
      },
      "expected": "12,50"
    },
    {
      "name": "comma: 12,50 + 3 (capped at 2 decimals)",
      "input": {
        "buffer": "12,50",
        "key": "3",
        "decimalSeparator": ","
      },
      "expected": "12,50"
    },
    {
      "name": "comma: 1234567 + 8 (7 digits, allowed)",
      "input": {
        "buffer": "1234567",
        "key": "8",
        "decimalSeparator": ","
      },
      "expected": "12345678"
    },
    {
      "name": "comma: 12345678 + 9 (8 digits, guarded)",
      "input": {
        "buffer": "12345678",
        "key": "9",
        "decimalSeparator": ","
      },
      "expected": "12345678"
    },
    {
      "name": "comma: 0 + comma",
      "input": {
        "buffer": "0",
        "key": ",",
        "decimalSeparator": ","
      },
      "expected": "0,"
    },
    {
      "name": "comma: 00000000 + 1 (leading zeros do not count)",
      "input": {
        "buffer": "00000000",
        "key": "1",
        "decimalSeparator": ","
      },
      "expected": "000000001"
    },
    {
      "name": "comma: 12,5 + back",
      "input": {
        "buffer": "12,5",
        "key": "back",
        "decimalSeparator": ","
      },
      "expected": "12,"
    },
    {
